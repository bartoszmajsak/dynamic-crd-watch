#!/bin/sh
#MISE description="Deploy controller to the cluster"
#MISE depends=["generate:manifests"]

IMG="${IMG:-localhost:5001/dynamic-crd-watch:test}"

# Build manifests without mutating config/manager/kustomization.yaml.
# Uses a temporary overlay under bin/ (gitignored) that sets the
# controller image, leaving the checked-in kustomization untouched.
overlay="bin/deploy-overlay"
mkdir -p "$overlay"

cat > "$overlay/kustomization.yaml" <<EOF
resources:
- ../../config/default
images:
- name: controller
  newName: ${IMG%:*}
  newTag: ${IMG##*:}
EOF

kustomize build "$overlay" | kubectl apply --server-side -f -
